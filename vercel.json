{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ambikaflowers-production-a69a.up.railway.app/api/:path*" },
    { "source": "/", "destination": "/index2" },
    { "source": "/((?!.*\\.).*)", "destination": "/index2" }
  ]
}
